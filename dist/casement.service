# casement.service: the compositor as a systemd user unit, started by the desktop's session.
#
# The account service (accountd) gives the `compositor` caller role, which lets casement register
# the Spaces it mints (`org.quire.Spaces1.Register`), only to the MAIN process of a unit named
# exactly `casement.service`. Until casement runs as this unit it is an ordinary app to accountd,
# Register is refused (logged once, the session carries on) and Spaces stay local to the machine.
#
# Installed root-held under /usr/lib/systemd/user (or /usr/local/lib/systemd/user, /etc/systemd/user),
# never under ~/.config: accountd trusts the unit only when its file, and every drop-in of it, sit in
# those root-held places, so a copy in the person's own folder is not trusted. The session does not
# use a drop-in either (not even one under $XDG_RUNTIME_DIR): it passes its arguments through the
# user manager's environment, as $CASEMENT_SESSION_ARGS (see ExecStart below).
#
# What the session (desktop-session) provides before it starts this unit:
#   - the user manager has the login session's environment imported (`systemctl --user
#     import-environment`): XDG_RUNTIME_DIR, DBUS_SESSION_BUS_ADDRESS (the session bus; casement
#     serves org.quire.Compositor1 and registers Spaces there), XDG_SEAT / XDG_SESSION_ID for the
#     tty backend's logind session;
#   - CASEMENT_SESSION_ARGS is set in the user manager (`systemctl --user set-environment`): the
#     per-session arguments, such as `--backend tty` or `--safe`. It is unset again when the
#     session ends;
#   - graphical-session-pre.target is reached (or started by the session) before this unit.
# What casement reads itself: $NOTIFY_SOCKET and $WATCHDOG_USEC / $WATCHDOG_PID (set by systemd
# for Type=notify), $XDG_STATE_HOME or $HOME (spaces.toml), $CASEMENT_LOG (log filter, default
# info). It starts no one's session for them: the Wayland socket name is announced on stderr and
# in the unit's STATUS= (`systemctl --user status casement`), and every program one of its key
# bindings starts gets it as WAYLAND_DISPLAY (and no NOTIFY_SOCKET, WATCHDOG_* or LISTEN_*).
#
# Expected ExecStart: the installed binary and the session's arguments. systemd splits the unbraced
# $CASEMENT_SESSION_ARGS on white space, and it is empty when the variable is not set:
#   /usr/bin/casement $CASEMENT_SESSION_ARGS
#   (no arguments: the `tty` backend on a seat; CASEMENT_SESSION_ARGS="--backend winit" nests
#    under another compositor when developing, "--backend tty --safe" is the safe mode)
#
# Type=notify: casement says READY=1 once its Wayland socket listens and the first outputs are
# announced, STOPPING=1 when it leaves, and WATCHDOG=1 at half of WatchdogSec while its loop
# turns. NotifyAccess=main: only the main process may speak for the unit, which is the process
# accountd sees as the compositor.
#
# Ordering: PartOf= graphical-session.target so the session's end stops it; After=
# graphical-session-pre.target. It is Wants-ed (not Requires/BindsTo) by the session's target
# so nothing here pulls the target back up: a crash restarts casement alone (Restart=on-failure)
# and the session decides whether to keep going.

[Unit]
Description=casement, the desktop compositor
Documentation=https://github.com/PoHsuanLai/casement
PartOf=graphical-session.target
After=graphical-session-pre.target
Before=graphical-session.target
# A crash loop stops here instead of restarting forever (the session then ends cleanly). Under
# the desktop session this limit is not what runs: desktop-session sees the unit leave the running
# state, stops it before the restart below fires, counts quick exits itself and starts
# `casement --safe` after three.
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/casement $CASEMENT_SESSION_ARGS
# A loader variable from the person's environment (a library to preload, a folder of plug-ins or
# drivers to load) must not load code into this trusted process: accountd gives this unit a fixed
# role only when the unit clears them, so none of them comes in through the user manager.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
# The tty backend takes the seat through logind; a clean exit (the person logged out) is not a
# failure and is not restarted.
Restart=on-failure
RestartSec=1
# A compositor that stops turning its loop is killed and restarted.
WatchdogSec=30
TimeoutStartSec=30
TimeoutStopSec=10
# The whole cgroup goes with the compositor: its clients cannot outlive their display server.
# The programs its key bindings start are not in it: each runs in a transient scope of the user
# manager (`systemd-run --user --scope`), so a restart of the compositor leaves a terminal's
# tmux server or a long build alone. Without a user manager they are plain children of this
# unit and end with it.
KillMode=control-group
# Every client connection costs descriptors and a user service starts at 1024: the compositor
# raises its soft limit itself, within this hard limit, and caps the connections it takes.
LimitNOFILE=65536
# The compositor's own log goes to the journal.
StandardOutput=journal
StandardError=journal

[Install]
# Started by the session (desktop-session), not enabled globally.
